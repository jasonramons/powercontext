+    if (nullptr != dict_main_) { dict_main_->~ObIFTDict(); dict_main_ = nullptr; }
+    if (nullptr != dict_quan_) { dict_quan_->~ObIFTDict(); dict_quan_ = nullptr; }
+    if (nullptr != dict_stop_) { dict_stop_->~ObIFTDict(); dict_stop_ = nullptr; }
