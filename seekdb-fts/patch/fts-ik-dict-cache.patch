+        ret = OB_SUCCESS;
+        if (OB_FAIL(hub->build_cache(desc, container))) {
+        }
+      }
+    }
+    if (OB_FAIL(ret)) {
+    } else if (OB_ISNULL(dict = OB_NEWx(ObFTRangeDict, &alloc_, alloc_, &container, desc))) {
+      ret = OB_ALLOCATE_MEMORY_FAILED;
+    } else if (OB_FAIL(dict->init())) {
+    }
+    return ret;
+  }
+};
